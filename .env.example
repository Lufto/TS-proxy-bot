# Скопируйте в .env и заполните. Секреты (токены) в чат и в git не отправлять.

# dev — Mac разработчика (только squad test и аккаунты dev_), prod — сервер (только аккаунты tg_)
RUN_MODE=dev
# fake — поддельная платёжка (только с RUN_MODE=dev), real — настоящая (задача 15),
# off — оплата выключена: тестовый запуск только с пробным, пока платёжка не выбрана
# (можно и в dev, и в prod; тарифы видны без кнопок оплаты, при запуске — тревога админам)
PAYMENTS_MODE=fake
# Файл платежей поддельной платёжки; «оплатить» — scripts/simulate_payment.py
FAKE_PAYMENTS_FILE=data/fake_payments.json

# Секреты
BOT_TOKEN=
REMNAWAVE_TOKEN=

REMNAWAVE_URL=https://panel.ts-proxy.com
# Squad для новых прокси-аккаунтов в режиме prod (в dev бот всегда кладёт их в squad test)
REMNAWAVE_SQUAD=Default-Squad
# Вебхуки Remnawave: тот же секрет, что WEBHOOK_SECRET_HEADER в .env панели (32+ букв и цифр).
# Панель шлёт вебхуки на <адрес бота в сети Docker>/remnawave/webhook (WEBHOOK_URL панели).
# Обязателен в RUN_MODE=prod. В dev пусто — вебхуки выключены, события догоняет сверка раз в 5 минут.
REMNAWAVE_WEBHOOK_SECRET=

# Только для RUN_MODE=prod: Telegram шлёт апдейты на PUBLIC_BASE_URL/telegram/webhook.
# Секрет — случайная строка 32+ символов A-Za-z0-9_- (например: openssl rand -hex 32).
# Чтобы сменить секрет, впишите новый и перезапустите бота — он сам переустановит вебхук.
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
# Где слушает веб-сервер бота (наружу его выводит nginx/caddy)
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Администраторы — Telegram ID через запятую
ADMIN_IDS=
# Группа администраторов и её темы
ADMIN_CHAT_ID=
PAYMENTS_THREAD_ID=
ALERTS_THREAD_ID=
BACKUPS_THREAD_ID=
REFUNDS_THREAD_ID=

DATABASE_URL=sqlite+aiosqlite:///data/tsproxy.db

# Бэкапы базы бота: папка с копиями (daily/ и monthly/) и файл открытого ключа age —
# тот же, что у бэкапов панели. На Mac для проверки можно указать, например, data/backups
BACKUP_DIR=/var/backups/tsproxy
BACKUP_AGE_RECIPIENTS=/etc/remnawave-backup/recipients.txt
LOG_LEVEL=INFO
