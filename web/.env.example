# Данные страниц берутся из apiStatic (мок-клиент @idem.agency/fetch); бэкенда у сайта нет
HTTP_CLIENT=mock
API=http://localhost:3000
AUTH_TYPE=basic
AUTH_TOKEN=
AUTH_LOGIN=
AUTH_PASSWORD=
DEBUG=false
# Отчёты о данных, не прошедших проверку схемой: в logs/api-*.log и в терминал
VALIDATION_LOG_ENABLED=false
VALIDATION_TERMINAL_LOG_ENABLED=true
API_LOG_MAX_SIZE=20m
API_LOG_MAX_FILES=50
