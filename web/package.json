{
  "name": "tsproxy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-config.mjs && concurrently -k -n mock,next -c cyan,magenta \"idem_mock apiStatic watch\" \"next dev\"",
    "build": "node scripts/generate-config.mjs && idem_mock apiStatic && next build",
    "start": "next start",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test:unit": "jest",
    "test": "node scripts/generate-config.mjs && idem_mock apiStatic && npm run test:unit && eslint \"**/*.{ts,tsx}\" && next build",
    "lint-fix": "eslint \"**/*.{ts,tsx}\" --fix",
    "sprites": "svg-sprite -s --symbol-dest public/icons --symbol-sprite sprite.svg src/assets/svg/*.svg && echo 'Спрайты успешно обновлены' && node cli/generate-sprites/node-generate-sprites.mjs",
    "check": "node scripts/check-site.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@idem.agency/fetch": "file:vendor/idem.agency-fetch-0.0.24.tgz",
    "@idem.agency/popups-engine": "file:vendor/idem.agency-popups-engine-0.0.11.tgz",
    "classix": "2.2.5",
    "dotenv": "16.6.1",
    "gsap": "3.13.0",
    "js-yaml": "4.1.1",
    "motion": "12.24.7",
    "next": "~16.2.6",
    "next-intl": "4.8.2",
    "overlayscrollbars-react": "0.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "scroll-lock": "2.1.5",
    "server-only": "0.0.1",
    "svg-sprite": "2.0.4",
    "winston": "3.18.3",
    "winston-daily-rotate-file": "5.0.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@stylistic/eslint-plugin": "5.8.0",
    "@tailwindcss/postcss": "4.1.17",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.25",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/scroll-lock": "2.1.3",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "eslint-config-next": "~16.2.6",
    "jest": "30.4.0",
    "jest-environment-jsdom": "30.4.0",
    "postcss": "8.4.31",
    "sass": "1.97.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  }
}
